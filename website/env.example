# OpenAI API Key (required for AI assistant features)
OPENAI_API_KEY=

# NASA API Key (optional, for enhanced rate limits)
# Get your key at: https://api.nasa.gov/
NASA_API_KEY=

# Site Configuration
# Base URL for the site (used for canonical URLs and sitemap generation)
NEXT_PUBLIC_SITE_URL=https://exo-bengal.vercel.app

# Database URL (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/exobengal

# Redis URL (for caching)
REDIS_URL=redis://localhost:6379

# Next Auth Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=

# Next Auth URL
NEXTAUTH_URL=http://localhost:3000

# Public API URL (for frontend API calls)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Analytics Configuration
# Google Analytics 4 for tracking user behavior and site performance
# Google Search Console for SEO monitoring and search appearance

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Get your ID at: https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification code (meta tag content)
# Get from: https://search.google.com/search-console
NEXT_PUBLIC_GSC_VERIFICATION=

# Plausible Analytics (alternative to Google Analytics)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Sentry DSN (optional, for error tracking)
SENTRY_DSN=

